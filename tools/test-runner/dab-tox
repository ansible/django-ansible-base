#!/usr/bin/env bash
# dab-tox — run tox inside the docker test container for django-ansible-base.
#
# Usage:
#   dab-tox [TOX_ARGS...]
#
# Examples:
#   dab-tox                                       # full py312 suite
#   dab-tox -e py312 -- test_app/tests/rbac/ -v  # specific directory
#   dab-tox -e py312 -- test_app/tests/rbac/test_foo.py::test_bar -v --no-header
#   dab-tox -e black -- ansible_base/ test_app/  # run a linter env
#   dab-tox -e isort -- ansible_base/ test_app/
#   dab-tox -e flake8 -- ansible_base/ test_app/
#
# The script must be run from the repo root (or any subdirectory).

set -euo pipefail

REPO_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
COMPOSE_FILE="$REPO_ROOT/docker-compose.test.yml"

if [[ ! -f "$COMPOSE_FILE" ]]; then
    echo "ERROR: docker-compose.test.yml not found at $REPO_ROOT" >&2
    exit 1
fi

# Default to py312 when no args given — the full envlist (py312-check,
# py312-sqlite, py312-in-files) makes it look like the suite restarts.
TOX_ARGS="${*:--e py312}"
exec docker compose -f "$COMPOSE_FILE" run --rm test-runner -c "tox $TOX_ARGS"
